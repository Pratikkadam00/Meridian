{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/data-display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/money/**",
              "components/navigation/**",
              "ui_kits/meridian-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Hanken Grotesk|IBM Plex Sans Arabic|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Hanken Grotesk, IBM Plex Sans Arabic, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|currency|size|tone|currencyAfter|key|ref|className|style|children)$/]",
        "message": "<Amount> doesn't accept that prop. Declared props: value, currency, size, tone, currencyAfter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Amount> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Amount'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|paid|muted|risk)$/]",
        "message": "<Amount> tone must be one of 'default' | 'paid' | 'muted' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|eyebrow|onBack|actions|bordered|center|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, eyebrow, onBack, actions, bordered, center."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|soft|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, soft, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|jade|amber|slate|sample)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'jade' | 'amber' | 'slate' | 'sample'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|leftIcon|rightIcon|loading|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, leftIcon, rightIcon, loading, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|raised|interactive|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, raised, interactive, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|ink|sunk)$/]",
        "message": "<Card> tone must be one of 'default' | 'ink' | 'sunk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceCue'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|chip|showWord|key|ref|className|style|children)$/]",
        "message": "<ConfidenceCue> doesn't accept that prop. Declared props: level, chip, showWord."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceCue'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:high|med|low)$/]",
        "message": "<ConfidenceCue> level must be one of 'high' | 'med' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldReviewRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|confidence|active|confirmed|money|key|ref|className|style|children)$/]",
        "message": "<FieldReviewRow> doesn't accept that prop. Declared props: label, value, confidence, active, confirmed, money."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldReviewRow'] > JSXAttribute[name.name='confidence'] > Literal[value!=/^(?:high|med|low)$/]",
        "message": "<FieldReviewRow> confidence must be one of 'high' | 'med' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|tonal|filled|danger)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'tonal' | 'filled' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|prefix|suffix|leadingIcon|mono|tone|help|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, required, prefix, suffix, leadingIcon, mono, tone, help, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|confirm|error)$/]",
        "message": "<Input> tone must be one of 'default' | 'confirm' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MilestoneRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|due|amount|status|type|statusLabel|currencyAfter|key|ref|className|style|children)$/]",
        "message": "<MilestoneRow> doesn't accept that prop. Declared props: title, due, amount, status, type, statusLabel, currencyAfter."
      },
      {
        "selector": "JSXOpeningElement[name.name='MilestoneRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:paid|due|upcoming|overdue|grace|atrisk)$/]",
        "message": "<MilestoneRow> status must be one of 'paid' | 'due' | 'upcoming' | 'overdue' | 'grace' | 'atrisk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MilestoneRow'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:time|construction)$/]",
        "message": "<MilestoneRow> type must be one of 'time' | 'construction'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|variant|showValue|marker|key|ref|className|style|children)$/]",
        "message": "<ProgressMeter> doesn't accept that prop. Declared props: value, label, variant, showValue, marker."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:construction|payment|neutral)$/]",
        "message": "<ProgressMeter> variant must be one of 'construction' | 'payment' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|fullWidth|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|subtitle|onClose|headerRight|children|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, title, subtitle, onClose, headerRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|children|dense|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: status, children, dense."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:paid|due|upcoming|overdue|grace|atrisk)$/]",
        "message": "<StatusPill> status must be one of 'paid' | 'due' | 'upcoming' | 'overdue' | 'grace' | 'atrisk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|badge|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, icon, badge."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|actionLabel|onAction|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, actionLabel, onAction, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|info|warn|error)$/]",
        "message": "<Toast> tone must be one of 'success' | 'info' | 'warn' | 'error'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
