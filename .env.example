EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL — used to build shareable client-portal links
# (web/app/shared/[token]). Same domain as web/.env.example's NEXT_PUBLIC_SITE_URL.
EXPO_PUBLIC_SITE_URL=https://meridian.ae
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SECURITY_ENFORCEMENT_MODE=report
EXPO_PUBLIC_NATIVE_CERT_PINNING_REQUIRED=false
EXPO_PUBLIC_DEVICE_INTEGRITY_REQUIRED=false
EXPO_PUBLIC_STATSIG_CLIENT_KEY=
EXPO_PUBLIC_FEATURE_AI_SPA_EXTRACTION=true
EXPO_PUBLIC_FEATURE_PUSH_REMINDERS=true
EXPO_PUBLIC_FEATURE_WHATSAPP_REMINDERS=true

# Never expose or prefix the Supabase service-role key in the mobile app.
